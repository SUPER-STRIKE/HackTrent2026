# Auth0 (nextjs-auth0 v4)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000


# Tiger Data (Timescale)
DATABASE_URL=

# Gemini
GEMINI_API_KEY=
# Optional: model for risk scoring (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: score (0-1) at or above which actions pause for approval (default 0.7)
RISK_THRESHOLD=



# Auth0 API identifier for agent tokens (M2M)
AUTH0_AUDIENCE= 
# Required: comma-separated M2M client ids allowed to ingest
AUTH0_AGENT_CLIENT_IDS=
# Required for approvals: comma-separated emails (verified in Auth0) allowed to approve/deny actions
APPROVER_EMAILS=
# Optional: PEM text of the Tiger Data CA to verify the DB certificate
DATABASE_CA=

# Agent simulator (npm run simulate): an Auth0 M2M app listed in AUTH0_AGENT_CLIENT_IDS
TRIPWIRE_URL=http://localhost:3000
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
